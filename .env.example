# Copy to .env and edit. Every value has a default; nothing here is required.

# --- host ports (change only if something already occupies them) ---
PG_PORT=5432
AMQP_PORT=5672
RABBIT_UI_PORT=15672
API_PORT=8080
UI_PORT=3000

SEED=20260828
WORKER_COUNT=4

# --- pipeline misbehaviour ---
FAIL_RATE=0.06          # jobs that fail at a random stage
LATENCY_MS=1.0          # multiplier on stage duration
HANG_RATE=0.01          # jobs that enter processing and never leave
DRIFT_PCT=0.04          # measurements nudged just past tolerance
SCHEMA_DRIFT=0.02       # outputs emitted under a different schema_version
UNIT_FLIP=0.0           # declare one `units`, report values in the other

# --- event / queue misbehaviour ---
DUPLICATE_WEBHOOKS=0.10
EVENT_DUP_RATE=0.08     # events published twice
EVENT_DROP_RATE=0.03    # events silently dropped
EVENT_REORDER_RATE=0.10 # events published out of order within a job
POISON_RATE=0.005       # malformed events (must land in the DLQ)

# --- graded defect profile (see README: Defect profiles) ---
# Comma-separated. Empty = a correct service. Interviewers set this; candidates leave it blank.
DEFECTS=
